// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "features": {
        "edit_prediction_provider": "zed"
    },
    "terminal": {
        "dock": "right"
    },
    "toolbar": {
        "breadcrumbs": false,
        "quick_actions": false
    },
    "assistant": {
        "default_model": {
            "provider": "google",
            "model": "gemini-2.5-flash"
        },
        "version": "2"
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },
    "vim_mode": true,
    "ui_font_family": "Hack Nerd Font",
    "buffer_font_family": "Hack Nerd Font",
    "ui_font_size": 13,
    "buffer_font_size": 11.0,
    "theme": {
        "mode": "system",
        "light": "Tokyo Night Storm",
        "dark": "Tokyo Night Storm"
    },
    "tab_size": 4,
    "format_on_save": "on",
    "relative_line_numbers": true,
    "languages": {
        "Python": {
            "format_on_save": {
                "external": {
                    "command": "/Users/jshiles/miniconda3/bin/black",
                    "arguments": ["-", "--line-length", "100"]
                }
            }
        },
        "SQL": {
            "format_on_save": "off"
        }
    },
    "language_models": {
        "ollama": {
            "api_url": "http://localhost:11434",
            "available_models": [
                {
                    "name": "qwen2.5-coder",
                    "display_name": "qwen 2.5 coder 32K",
                    "max_tokens": 32768
                }
            ]
        }
    }
}
