// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
    {
        "context": "Editor && VimControl && !VimWaiting && !menu",
        "bindings": {
            "space w": "workspace::Save",
            "space b": "editor::ToggleGitBlame",
            "space l f": "editor::Format",
            "space c": "pane::CloseActiveItem",
            "space o": "tab_switcher::Toggle",
            "space v": "pane::SplitVertical",
            "space /": "workspace::NewSearch",
            "g b": "editor::ToggleComments"
        }
    },
    {
        "context": "(Dock || Terminal || Editor) && VimControl",
        "bindings": {
            "space h": ["workspace::ActivatePaneInDirection", "Left"],
            "space l": ["workspace::ActivatePaneInDirection", "Right"]
        }
    },
    {
        "context": "Workspace",
        "bindings": {
            "cmd-p": [
                "task::Spawn",
                { "task_name": "file_finder", "reveal_target": "center" }
            ],
            "cmd-f": [
                "task::Spawn",
                { "task_name": "fulltext_search", "reveal_target": "center" }
            ]
            // "shift shift": "file_finder::Toggle"
        }
    },
    {
        "context": "Editor",
        "bindings": {
            // "j k": ["workspace::SendKeystrokes", "escape"]
        }
    },
    {
        "context": "TabSwitcher",
        "bindings": {
            "k": "menu::SelectPrev",
            "j": "menu::SelectNext",
            "x": "tab_switcher::CloseSelectedItem"
        }
    }
]
